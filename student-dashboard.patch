+def load_student_overview(user_id):
+    """Return ({class_id: name}, assignments, {assignment_id: latest submission})."""
+    student_id = db._object_id(user_id, "user ID")
+    class_ids = [row["class_id"] for row in db.find("students", {"user_id": student_id})]
+    if not class_ids:
+        return {}, [], {}
+    classes = {
+        row["_id"]: row.get("name", "Untitled class")
+        for row in db.find("classes", {"_id": {"$in": class_ids}})
+    }
+    homework_list = list_assignments_for_student(user_id)
+    latest = {}
+    # Submissions come back newest first, so the first one per assignment is the latest.
+    for submission in list_submissions_for_student(user_id):
+        latest.setdefault(submission["assignment_id"], submission)
+    return classes, homework_list, latest
+
+
+def homework_state(assignment, submission=None, now=None):
+    if submission:
+        return "submitted"
+    state = assignment_state(assignment, now)
+    return state if state in ("past_due", "closed") else "open"
+
+
+def _problem_summary(assignment):
+    try:
+        problems = normalize_problems(assignment.get("problems"))
+    except ValueError:
+        return f"{len(assignment.get('problems') or [])} questions"
+    count = len(problems)
+    points = sum(problem["points"] for problem in problems)
+    return f"{count} question{'s' if count != 1 else ''} · {points:g} pt{'s' if points != 1 else ''}"
+
+
+def _score_percentage(submission):
+    result = (submission or {}).get("grading_result") or {}
+    if submission and submission.get("grading_status") == "graded" and "percentage" in result:
+        return result["percentage"]
+    return None
+
+
+def _render_overview(states, latest):
+    now = datetime.now(timezone.utc)
+    week_from_now = now + timedelta(days=7)
+    to_do = sum(state in ("open", "past_due") for _, state in states)
+    due_soon = sum(
+        state == "open" and (due_end := _due_end(assignment)) is not None and due_end <= week_from_now
+        for assignment, state in states
+    )
+    submitted = sum(state == "submitted" for _, state in states)
+    scores = [score for submission in latest.values() if (score := _score_percentage(submission)) is not None]
+    columns = st.columns(4)
+    columns[0].metric("To do", to_do)
+    columns[1].metric("Due in 7 days", due_soon)
+    columns[2].metric("Submitted", submitted)
+    columns[3].metric("Average AI score", f"{sum(scores) / len(scores):.0f}%" if scores else "—")
+
+
