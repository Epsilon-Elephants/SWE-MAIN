+"""Student dashboard: homework states, overview numbers, cards, classes, and settings."""
+
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+from bson import ObjectId
+from streamlit.testing.v1 import AppTest
+
+from pages.dashboards.student.student import homework_state
+
+NOW = datetime(2026, 11, 10, 12, tzinfo=timezone.utc)
+
+
+@pytest.mark.parametrize("assignment,submission,expected", [
+    ({"status": "published", "due_date": datetime(2026, 11, 12)}, None, "open"),
+    ({"status": "published", "due_date": datetime(2026, 11, 8)}, None, "past_due"),
+    ({"status": "closed"}, None, "closed"),
+    ({"status": "published", "due_date": datetime(2026, 11, 8)}, {"grading_status": "ungraded"}, "submitted"),
+])
+def test_homework_state(assignment, submission, expected):
+    assert homework_state(assignment, submission, NOW) == expected
+
+
+def dashboard_app():
+    app = AppTest.from_file(str(Path(__file__).resolve().parents[1] / "app/app.py"))
+    app.session_state.user = {
+        "id": str(ObjectId()), "email": "grace@example.com",
+        "permissions": "student", "first_name": "Grace",
+    }
+    return app
+
+
+def overview():
+    now = datetime.now(timezone.utc)
+    logic, sets = ObjectId(), ObjectId()
+    due_soon = {
+        "_id": ObjectId(), "class_id": logic, "title": "Truth tables", "status": "published",
+        "due_date": now + timedelta(days=2), "problems": [{"content": "Explain AND.", "points": 2}],
+    }
+    late = {
+        "_id": ObjectId(), "class_id": logic, "title": "Proofs", "status": "published",
+        "due_date": now - timedelta(days=3), "problems": ["Prove it."],
+    }
+    done = {
+        "_id": ObjectId(), "class_id": sets, "title": "Venn diagrams", "status": "published",
+        "due_date": now - timedelta(days=1), "problems": ["Draw one."],
+    }
+    submission = {
+        "_id": ObjectId(), "assignment_id": done["_id"], "submitted_at": now - timedelta(days=2),
+        "grading_status": "graded",
+        "grading_result": {"total_points": 9, "max_points": 10, "percentage": 90},
+    }
+    return (
+        {logic: "Logic 101", sets: "Set Theory"},
+        [due_soon, late, done],
+        {done["_id"]: submission},
+    ), due_soon
+
+
+def test_dashboard_shows_overview_cards_and_classes():
+    data, due_soon = overview()
+    app = dashboard_app()
